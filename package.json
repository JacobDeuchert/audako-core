{
  "name": "@audako/core",
  "version": "2.2.0",
  "description": "Core Services, Models and Functions for the audako platform",
  "main": "./dist/cjs/index.js",
  "module": "./dist/mjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/mjs/index.d.ts",
        "default": "./dist/mjs/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p ./lib/tsconfig.json --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "build": "rm -rf dist && tsc -p ./lib/tsconfig.json && tsc -p ./lib/tsconfig-cjs.json && echo '{\"type\": \"module\"}' > dist/mjs/package.json && echo '{\"type\": \"commonjs\"}' > dist/cjs/package.json",
    "prepublishOnly": "npm test && npm run build"
  },
  "author": "Jacob Deuchert",
  "license": "MIT",
  "dependencies": {
    "@microsoft/signalr": "^6.0.8",
    "axios": "^1.13.2",
    "rxjs": "^7.5.5"
  },
  "devDependencies": {
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^5.3.2",
    "vitest": "^5.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "docs/migration-2.0.md"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JacobDeuchert/audako-core.git"
  },
  "publishConfig": {
    "registry": "https://git.dev.audako.net/api/packages/audako/npm/"
  }
}
